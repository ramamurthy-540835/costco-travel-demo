# Playwright regression suite — authenticated fixtures (tests/e2e/fixtures/)
# Copy to .env.test (gitignored) and fill in real values before running
# `npm run test:e2e:regression`.

# Clerk test-instance user — create in the Clerk dashboard's test-mode users.
# Use a `+clerk_test@` email alias per Clerk's E2E testing docs so the account
# is recognized as a test user and bypasses live email/SMS verification.
E2E_CLERK_TEST_EMAIL=e2e+clerk_test@example.com
E2E_CLERK_TEST_PASSWORD=

# Base URL the regression suite drives against — defaults to localhost:3000.
PLAYWRIGHT_BASE_URL=http://localhost:3000
