# Clerk (auth) — https://dashboard.clerk.com → API Keys
NEXT_PUBLIC_CLERK_PUBLISHABLE_KEY=
CLERK_SECRET_KEY=
NEXT_PUBLIC_CLERK_SIGN_IN_URL=/agentic-travels/sign-in
NEXT_PUBLIC_CLERK_SIGN_UP_URL=/agentic-travels/sign-up

# E2E-only vars (Clerk test-instance credentials, etc.) live in .env.test —
# see .env.test.example, not this file.

# MongoDB (Member/Booking documents) — local docker-compose Mongo by default
MONGODB_URI=mongodb://localhost:27018/agentic_travel

# Apache AGE graph (Inventory/Vendor/NegotiatedTerm nodes) — local docker-compose Postgres+AGE by default
GRAPH_DATABASE_URL=postgresql://postgres:localdev@localhost:5434/rental

# Azure OpenAI (LLM-backed graph vocabulary enrichment, e.g. graph/scripts/backfill_synonyms.py)
AZURE_OPENAI_API_KEY=
AZURE_OPENAI_ENDPOINT=
AZURE_OPENAI_DEPLOYMENT_NAME=
AZURE_API_VERSION=

# Stripe (payments) — https://dashboard.stripe.com/test/apikeys
# Both keys MUST come from the same Stripe account/mode (test vs live) or PaymentIntents will fail to retrieve.
STRIPE_SECRET_KEY=sk_test_...
NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY=pk_test_...
